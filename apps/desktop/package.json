{
  "name": "@dnd/desktop",
  "productName": "DnD Initiative Tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Encounter builder and initiative tracker for D&D Beyond campaigns",
  "author": "Michael",
  "main": "dist/main.cjs",
  "scripts": {
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/main.cjs --external:electron --external:bufferutil --external:utf-8-validate --log-level=warning",
    "start": "npm run build -w @dnd/web && npm run bundle && electron .",
    "dist": "npm run build -w @dnd/web && npm run bundle && electron-builder --publish never"
  },
  "devDependencies": {
    "@dnd/server": "*",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.mikennel.dnd-initiative-tracker",
    "productName": "DnD Initiative Tracker",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**", "package.json"],
    "extraResources": [
      { "from": "../web/dist", "to": "web" },
      { "from": "../extension", "to": "extension" }
    ],
    "asar": true,
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": "dmg", "category": "public.app-category.games", "identity": null },
    "linux": { "target": "AppImage" }
  }
}
